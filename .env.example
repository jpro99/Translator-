# Optional — app works without these using free EU-friendly providers (Lingva, MyMemory, LibreTranslate).
# Copy to .env.local for local dev. For GitHub Pages, add as repository secrets and map in workflow if needed.

# DeepL Free API — excellent for Italian ↔ English (https://www.deepl.com/pro-api)
VITE_DEEPL_API_KEY=

# Microsoft Azure Translator — strong EU coverage (https://azure.microsoft.com/products/ai-services/translator)
VITE_AZURE_TRANSLATOR_KEY=
VITE_AZURE_TRANSLATOR_REGION=westeurope
